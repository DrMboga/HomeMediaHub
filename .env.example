# Generic template — use .env.stage.example or .env.prod.example instead.
# Copy the relevant file, rename it (remove .example), fill in passwords.

COMPOSE_PROJECT_NAME=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=

IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=

GEOSERVICE_DB_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASS=

GRAFANA_PASSWORD=

# Photo of the Day — false everywhere except prod (see .env.stage.example / .env.prod.example)
POTD_ENABLED=false
POTD_BOT_TOKEN=
POTD_CHAT_ID=
POTD_TIMEZONE=Europe/Berlin

# Paths — differ between stage and prod (see .env.stage.example / .env.prod.example)
PHOTO_DIR=
THUMBNAILS_DIR=
VIDEO_CACHE_DIR=
WORK_DIR=
DATA_DIR=
