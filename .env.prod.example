# Prod environment — real Photo library on SATA HDD.
# Copy to .env.prod and fill in passwords.
# Run with: docker compose --env-file .env.prod up -d
# SATA HDD must be mounted at /mnt/storage before starting.

COMPOSE_PROJECT_NAME=hmh-prod

POSTGRES_USER=postgres
POSTGRES_PASSWORD=

IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=

GEOSERVICE_DB_PASSWORD=

MIKE_PASSWORD=
BADGER_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASS=

GRAFANA_PASSWORD=

# Photo of the Day — daily Telegram post at POTD_TIMEZONE 15:00.
# Bot token and chat ID come from docs/telegram-potd-setup.md sections 1-3.
# This is the environment that posts to the family channel.
POTD_ENABLED=true
POTD_BOT_TOKEN=
POTD_CHAT_ID=
POTD_TIMEZONE=Europe/Berlin

# Prod paths (SATA HDD)
PHOTO_DIR=/mnt/storage/Photo
THUMBNAILS_DIR=/mnt/storage/thumbnails
VIDEO_CACHE_DIR=/mnt/storage/video-cache
DISPLAY_CACHE_DIR=/mnt/storage/display-cache
WORK_DIR=/tmp/homemediahub-prod
DATA_DIR=/opt/homemediahub/data
