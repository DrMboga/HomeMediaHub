# Prod environment — real Photo library on USB HDD.
# Copy to .env.prod and fill in passwords + SERVER_IP.
# Run with: docker compose --env-file .env.prod up -d
# USB HDD must be mounted at /mnt/usb-hdd before starting.

COMPOSE_PROJECT_NAME=hmh-prod
SERVER_IP=192.168.0.192

POSTGRES_USER=postgres
POSTGRES_PASSWORD=

IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=

GEOSERVICE_DB_PASSWORD=

MIKE_PASSWORD=
BADGER_PASSWORD=

# Prod paths (USB HDD)
PHOTO_DIR=/mnt/usb-hdd/Photo
THUMBNAILS_DIR=/mnt/usb-hdd/thumbnails
VIDEO_CACHE_DIR=/mnt/usb-hdd/video-cache
WORK_DIR=/tmp/homemediahub-prod
DATA_DIR=/opt/homemediahub/data
