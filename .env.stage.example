# Stage environment — TestPhoto on server SSD.
# Copy to .env.stage and fill in passwords.
# Run with: docker compose --env-file .env.stage up -d

COMPOSE_PROJECT_NAME=hmh-stage

POSTGRES_USER=postgres
POSTGRES_PASSWORD=

IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=

GEOSERVICE_DB_PASSWORD=

MIKE_PASSWORD=
BADGER_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASS=

GRAFANA_PASSWORD=

# Photo of the Day — MUST stay false here. Stage and prod share ports and one compose file, and
# stage must never post to the family channel. The Admin page's Send Now button still works: it
# deliberately ignores this flag, because a button press is not an accident.
POTD_ENABLED=false
POTD_BOT_TOKEN=
POTD_CHAT_ID=
POTD_TIMEZONE=Europe/Berlin

# Stage paths (all on SSD — no USB HDD required)
PHOTO_DIR=/opt/homemediahub/stage/TestPhoto
THUMBNAILS_DIR=/opt/homemediahub/stage/thumbnails
VIDEO_CACHE_DIR=/opt/homemediahub/stage/video-cache
DISPLAY_CACHE_DIR=/opt/homemediahub/stage/display-cache
WORK_DIR=/tmp/homemediahub-stage
DATA_DIR=/opt/homemediahub/stage/data

# Library scan filters (Phase 14). Stage runs no Immich, so there is nothing to exclude —
# an empty value means "exclude nothing", which is the pre-Phase-14 behaviour.
SCAN_EXCLUDE_DIRS=
SCAN_MIN_FILE_AGE_SECONDS=120
